# Helix configuration. Copy to .env in the repository root.
# Every value is optional: with no .env the API runs on SQLite, an in-process job queue and a
# local artifact directory, and the web app calls http://localhost:8000.
#
# Read by the API (pydantic-settings; api/.env overrides this file) and by the web app
# (web/next.config.ts; web/.env.local overrides this file). Variables already set in the
# process environment win over both. Values shown are the defaults unless the comment says example.

# ---------------------------------------------------------------- Web (inlined at build time)

# Base URL of the Helix API as the browser reaches it. Routes are under /api/v1.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Source repository linked from the top bar, home and About. Unset: links to /about#open-source.
# NEXT_PUBLIC_REPOSITORY_URL=

# ---------------------------------------------------------------- API: process

# development | production | test. Outside development, only HELIX_CORS_ORIGINS may call the API.
# HELIX_ENVIRONMENT=development
# HELIX_LOG_LEVEL=INFO
# text | json
# HELIX_LOG_FORMAT=text
# Fail at startup when a source, provider, job handler or router module does not import,
# instead of skipping it and listing it under load_errors in GET /api/v1/health.
# HELIX_STRICT_IMPORTS=false

# ---------------------------------------------------------------- API: HTTP

# Comma-separated list or JSON array of allowed browser origins.
# HELIX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Regular expression of further allowed origins. Unset: any localhost port in development, none otherwise.
# HELIX_CORS_ORIGIN_REGEX=

# ---------------------------------------------------------------- API: storage

# Default: SQLite at api/var/helix.db. PostgreSQL (example below) needs `pip install 'helix[postgres]'`.
# HELIX_DATABASE_URL=postgresql://helix@localhost:5432/helix

# auto | local | s3. auto uses S3 when HELIX_S3_BUCKET is set.
# HELIX_ARTIFACT_STORE=auto
# Default: api/var/artifacts. The value below is an example.
# HELIX_ARTIFACT_DIR=/var/lib/helix/artifacts
# S3-compatible artifact store, needs `pip install 'helix[s3]'`.
# HELIX_S3_BUCKET=
# HELIX_S3_PREFIX=
# HELIX_S3_ENDPOINT_URL=
# HELIX_S3_REGION=
# HELIX_S3_ACCESS_KEY_ID=
# HELIX_S3_SECRET_ACCESS_KEY=

# Seeded dataset and cached model outputs. Defaults: data/seed and data/examples.
# HELIX_SEED_DIR=
# HELIX_EXAMPLES_DIR=

# ---------------------------------------------------------------- API: jobs

# auto | memory | redis. auto uses Redis when HELIX_REDIS_URL is set.
# HELIX_JOB_QUEUE=auto
# Redis queue (example below), needs `pip install 'helix[redis]'` and a worker: `make worker`.
# HELIX_REDIS_URL=redis://localhost:6379/0
# Run the worker inside the API process. Unset: true with the in-process queue, false with Redis.
# HELIX_EMBEDDED_WORKER=
# Jobs run at once per worker.
# HELIX_JOB_CONCURRENCY=2
# HELIX_JOB_HEARTBEAT_SECONDS=10
# A running job with no heartbeat for this long is treated as orphaned (Redis queue).
# HELIX_JOB_STALE_AFTER_SECONDS=90
# HELIX_JOB_MAX_ATTEMPTS=2

# ---------------------------------------------------------------- API: upstream sources

# Sent to upstream sources in the User-Agent and to NCBI as `email`.
# HELIX_CONTACT_EMAIL=
# NCBI E-utilities key (raises the limit from 3 to 10 requests per second).
# HELIX_NCBI_API_KEY=
# Sources restricted to non-commercial use (CADD, REVEL and similar) stay off unless this is true.
# HELIX_ENABLE_NONCOMMERCIAL_SOURCES=false
# Seconds per upstream request, and per-source overrides as JSON or `chembl=30,ensembl=30`.
# HELIX_SOURCE_TIMEOUT_DEFAULT=10
# HELIX_SOURCE_TIMEOUTS=
# HELIX_SOURCE_MAX_RETRIES=2
# Seconds an aggregated endpoint waits for all of its sources.
# HELIX_GATHER_TIMEOUT_DEFAULT=20
# Cache upstream responses in the database.
# HELIX_HTTP_CACHE_ENABLED=true
# true: wait for the source when a cached response has expired. Default: answer with the expired
# copy (marked stale) and refresh it in the background.
# HELIX_HTTP_CACHE_REFRESH_BLOCKING=false

# ---------------------------------------------------------------- API: model providers

# Local Boltz command line (example below). Unset: the boltz2 provider reports not configured.
# HELIX_BOLTZ_EXECUTABLE=boltz
# HELIX_BOLTZ_CACHE_DIR=
# gpu | cpu | mps
# HELIX_BOLTZ_ACCELERATOR=
# MSA server for models that need one.
# HELIX_MSA_SERVER_URL=

# ---------------------------------------------------------------- API: assistant

# Anthropic API key for the research assistant. Unset: the assistant reports not configured.
# ANTHROPIC_API_KEY=
