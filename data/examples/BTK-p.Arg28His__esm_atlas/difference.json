    {
      "id": "similar_fold_is_uninformative",
      "text": "A predictor producing a similar fold for the variant sequence is expected for most single substitutions and is uninformative about stability.",
      "quoted_from": null,
      "citations": []
    },
    {
      "id": "plddt_is_model_behaviour",
      "text": "pLDDT is each model's own confidence estimate. The two values at the site are model behaviour, never measured destabilisation. Low pLDDT means disorder or insufficient information.",
      "quoted_from": null,
      "citations": []
    },
    {
      "id": "geometry_from_predicted_models",
      "text": "Distances, contacts and displacements are geometry computed from predicted models, not observations of the protein.",
      "quoted_from": null,
      "citations": []
    },
    {
      "id": "run_to_run_variation_not_estimated",
      "text": "This model is deterministic: there is no seed and one model per sequence, so run-to-run variation is not estimated and no noise baseline is available for these differences.",
      "quoted_from": null,
      "citations": []
    },
    {
      "id": "construct_is_a_window",
      "text": "Both models cover a residue window, not the full-length protein. Contacts with the rest of the chain, with partners and with ligands are absent from both.",
