# Copy to api/.env. Every value is optional: the API runs with none of them set.
# api/.env overrides the repository .env; the complete list of settings is in ../.env.example.

# HELIX_DATABASE_URL=postgresql://helix@localhost:5432/helix
# HELIX_REDIS_URL=redis://localhost:6379/0
# HELIX_ARTIFACT_DIR=/var/lib/helix/artifacts
# HELIX_S3_BUCKET=
# HELIX_S3_ENDPOINT_URL=
# HELIX_S3_REGION=
# HELIX_S3_ACCESS_KEY_ID=
# HELIX_S3_SECRET_ACCESS_KEY=

# HELIX_CORS_ORIGINS=http://localhost:3000
# HELIX_CONTACT_EMAIL=
# HELIX_NCBI_API_KEY=
# ANTHROPIC_API_KEY=

# Sources restricted to non-commercial use stay off unless this is true
# HELIX_ENABLE_NONCOMMERCIAL_SOURCES=false

# HELIX_BOLTZ_EXECUTABLE=boltz
# HELIX_BOLTZ_CACHE_DIR=
# HELIX_BOLTZ_ACCELERATOR=gpu
# HELIX_MSA_SERVER_URL=

# HELIX_SOURCE_TIMEOUT_DEFAULT=10
# HELIX_SOURCE_TIMEOUTS=chembl=30,ensembl=30
