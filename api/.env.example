# Copy to api/.env. Every value is optional: the API runs with none of them set.
# api/.env overrides the repository .env; the complete list of settings is in ../.env.example.

# ORPHAFOLD_DATABASE_URL=postgresql://orphafold@localhost:5432/orphafold
# ORPHAFOLD_REDIS_URL=redis://localhost:6379/0
# ORPHAFOLD_ARTIFACT_DIR=/var/lib/orphafold/artifacts
# ORPHAFOLD_S3_BUCKET=
# ORPHAFOLD_S3_ENDPOINT_URL=
# ORPHAFOLD_S3_REGION=
# ORPHAFOLD_S3_ACCESS_KEY_ID=
# ORPHAFOLD_S3_SECRET_ACCESS_KEY=

# ORPHAFOLD_CORS_ORIGINS=http://localhost:3000
# ORPHAFOLD_CONTACT_EMAIL=
# ORPHAFOLD_NCBI_API_KEY=
# ANTHROPIC_API_KEY=

# Sources restricted to non-commercial use stay off unless this is true
# ORPHAFOLD_ENABLE_NONCOMMERCIAL_SOURCES=false

# ORPHAFOLD_BOLTZ_EXECUTABLE=boltz
# ORPHAFOLD_BOLTZ_CACHE_DIR=
# ORPHAFOLD_BOLTZ_ACCELERATOR=gpu
# ORPHAFOLD_MSA_SERVER_URL=

# ORPHAFOLD_SOURCE_TIMEOUT_DEFAULT=10
# ORPHAFOLD_SOURCE_TIMEOUTS=chembl=30,ensembl=30
